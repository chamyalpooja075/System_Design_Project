{
  "name": "system-design-with-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run start:dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run start:dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "test": "npm run test --workspace=server",
    "check:keys": "python scripts/scan_keys.py",
    "db:clean": "npm run db:clean --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
