# Server Configuration
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL with pgvector)
# For local Docker: postgresql://postgres:postgres@localhost:5432/system_design
# For cloud Neon / Supabase: postgresql://[user]:[password]@[host]/[dbname]?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/system_design

# Redis (Caching & Rate Limiting)
# For local Docker: redis://localhost:6379
# For Upstash: rediss://default:[password]@[endpoint]:6379
REDIS_URL=redis://localhost:6379

# Kafka / Redpanda Broker
KAFKA_BROKERS=localhost:19092

# JWT Authentication
JWT_SECRET=super-secret-system-design-jwt-key-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# LLM Providers (Provider-agnostic interface)
# Free tier options: GEMINI_API_KEY or GROQ_API_KEY
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Context7 MCP (Documentation Server, optional - higher rate limits)
CONTEXT7_API_KEY=

